# ─────────────────────────────────────────────────────────────────
# AURA Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# Local: leave as-is (SQLite)
# Production (Render): set to your managed PostgreSQL connection string
#   e.g. postgresql+asyncpg://user:password@host:5432/aura
DATABASE_URL=sqlite:///./aura.db

# ── JWT Security ─────────────────────────────────────────────────
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=aura_development_secret_key_change_in_production_123456789

# ── Gemini AI ─────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Production example:
#   CORS_ORIGINS=https://aura-web.vercel.app,https://www.aura-web.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
